# Streamlit Community Cloud 배포 시: 앱 Settings > Secrets 에 아래 내용을 붙여넣는다.
# (최상위 키는 환경변수로도 노출되므로 src/config.py 가 .env 와 동일하게 읽는다)
# 로컬에서 쓰려면 .streamlit/secrets.toml 로 복사 (커밋 금지)

FOREST_FIRE_API_ENDPOINT = "http://apis.data.go.kr/1400000/forestStusService/getfirestatsservice"
FOREST_FIRE_SERVICE_KEY = ""
FOREST_FIRE_NUM_OF_ROWS = "99"
