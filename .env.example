# 산림청 산불통계 OpenAPI 설정
# 1) 이 파일을 .env 로 복사:  cp .env.example .env
# 2) 아래 값을 채운다. (.env 는 .gitignore 에 포함되어 커밋되지 않음)

# 요청 주소 (활용가이드 v1.3 요청 예제 기준)
FOREST_FIRE_API_ENDPOINT=http://apis.data.go.kr/1400000/forestStusService/getfirestatsservice

# 공공데이터포털 마이페이지 > 활용신청 현황 > 인증키
# '일반 인증키(Decoding)' 값을 권장. Encoding 키(%2B 등 포함)를 넣어도 코드에서 자동 디코딩함.
FOREST_FIRE_SERVICE_KEY=

# 한 페이지당 행 수 (가이드상 항목크기 2자리 → 최대 99 권장)
FOREST_FIRE_NUM_OF_ROWS=99
